@page
@model TP1_Web4.Pages.Evenements.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Modifier l'évènement</h1>
<hr />
<div class="row">
    <div class="col-md-12">
        <img src="@Model.ImageFolder@Model.Evenement.Image" alt="Image de l'évènement" class="text-center d-block m-auto w-50"/>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Evenement.Id" />
            <div class="form-group">
                <label asp-for="Evenement.Titre" class="control-label"></label>
                <input asp-for="Evenement.Titre" class="form-control" />
                <span asp-validation-for="Evenement.Titre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Evenement.Description" class="control-label"></label>
                <input asp-for="Evenement.Description" class="form-control" />
                <span asp-validation-for="Evenement.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageUpload" class="control-label"></label>
                <input asp-for="ImageUpload" class="form-control" />
                <span asp-validation-for="ImageUpload" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Evenement.Auteur" class="control-label"></label>
                <input asp-for="Evenement.Auteur" class="form-control" />
                <span asp-validation-for="Evenement.Auteur" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Evenement.CategorieId" class="control-label"></label>
                <select asp-for="Evenement.CategorieId" class="form-control" asp-items="ViewBag.CategorieId" ></select>
                <span asp-validation-for="Evenement.CategorieId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Evenement.DateDebut" class="control-label"></label>
                <input asp-for="Evenement.DateDebut" class="form-control" />
                <span asp-validation-for="Evenement.DateDebut" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Evenement.DateFin" class="control-label"></label>
                <input asp-for="Evenement.DateFin" class="form-control" />
                <span asp-validation-for="Evenement.DateFin" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Evenement.Addresse" class="control-label"></label>
                <input asp-for="Evenement.Addresse" class="form-control" />
                <span asp-validation-for="Evenement.Addresse" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Evenement.Ville" class="control-label"></label>
                <input asp-for="Evenement.Ville" class="form-control" />
                <span asp-validation-for="Evenement.Ville" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Evenement.CodePostal" class="control-label"></label>
                <input asp-for="Evenement.CodePostal" class="form-control" />
                <span asp-validation-for="Evenement.CodePostal" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Sauvegarder" class="btn btn-primary text-center m-auto d-block w-50 mb-3 mt-3" />
            </div>
        </form>
    </div>
</div>

<div>
    <a class="btn btn-primary text-center d-block m-auto w-50" asp-page="./Index">Retour à la liste</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
