@page "{id:guid}"
@model TP1_Web4.Pages.Evenements.DetailsModel

@{
    ViewData["Title"] = "Details";
}

@if (TempData["Confirmation"] != null)
{  
    <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Confirmation"]
   </div>
}

@if (TempData["Erreur"] != null)
{  
    <div class="alert alert-danger alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Erreur"]
   </div>
}

<h1>Détails de l'évènement</h1>

<div class="m-auto">
    <h4>Evenement</h4>
    <hr />
    <img class="d-block m-auto w-75" src="@Model.ImageFolder@Model.Evenement.Image" alt="Image de l'évènement"/>
    <dl class="row text-center m-auto d-block">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Titre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Titre)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Description)
        </dd>
        <dt class="col-sm-2">
            Nombre de participants
        </dt>
        <dd class="col-sm-10">
                @if (Model.Evenement.Participants?.Count > 0)
                {
                    <text>@Model.Evenement.Participants.Count</text>
                }
                else
                {
                    <text>Aucun participant</text>
                }
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Categorie)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Categorie.Nom)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.DateDebut)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.DateDebut)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.DateFin)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.DateFin)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Annule)
        </dt>
        <dd class="col-sm-10">
            @if (Model.Evenement.Annule == true)
            {
                <text>Oui</text>
            }
            else
            {
                <text>Non</text>
            }
        </dd> 
        @if (User.Identity.IsAuthenticated)
        {   
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Evenement.Addresse)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Evenement.Addresse)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Evenement.CodePostal)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Evenement.CodePostal)
            </dd>
             <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Evenement.Auteur)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Evenement.Auteur.UserName)
            </dd>
        }
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Evenement.Ville)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Evenement.Ville)
        </dd>
         @if (User.Identity.IsAuthenticated)
	     {
             <dt class="col-sm-2">
                Distance
            </dt>
            @if (Model.Distance.DistanceInKm == -1)
            {
                <dd class="col-sm-10">
                    Impossible de calculer la distance entre vous et l'évènement pour le moment.
                </dd>
            }
            else
            {  
                <dd class="col-sm-10">
                    @Model.Distance.DistanceInKm km
                </dd>
            }
			@if (Model.Evenement.Participants?.Contains(Model.Usr.Id) == true)
			{
                @if (Model.Evenement.AuteurId == Model.Usr.Id)
                {
                     <a class="btn btn-primary text-center w-50" asp-page="/Evenements/Delete" asp-route-id="@Model.Evenement.Id" class="btn btn-info mt-2">Annuler mon évènement</a>
                }
                else
                {  
                    <form method="post"
                        asp-page-handler="AnnulerParticipation"
                        asp-route-id="@Model.Evenement.Id" class="mt-3">
    
                        <button type="submit" class="btn btn-primary text-center w-50">
                            Annuler ma participation
                        </button>
                    </form>
                }
			}
			else if (Model.Evenement.Auteur.UserName != User.Identity.Name)
			{
                 <form method="post"
                        asp-page-handler="Participer"
                        asp-route-id="@Model.Evenement.Id" class="mt-3">
    
                        <button type="submit" class="btn btn-primary text-center w-50">
                            Participer
                        </button>
                    </form>	
			}	
        }
    </dl>
</div>
<div>
    <a class="btn btn-primary m-auto d-block w-50 mt-3" asp-page="../Index">Retour à l'accueil</a>
</div>
