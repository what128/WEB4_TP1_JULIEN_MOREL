@page
@model TP1_Web4.Pages.Evenements.IndexModel

@{
    ViewData["Title"] = "Mes évènements";
}

@if (TempData["Confirmation"] != null)
{  
    <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Confirmation"]
   </div>
}

@if (TempData["Erreur"] != null)
{  
    <div class="alert alert-danger alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Erreur"]
   </div>
}

<h1 class="text-center">Mes Évènements</h1>

<a class="btn btn-primary w-25 d-inherit m-auto mb-3" asp-page="Create">Créer un nouvel évènement</a>
@if(Model.Evenement.Count == 0)
{
    <p>Vous n'avez encore créé aucun évènement.</p>
}
else
{ 
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Evenement[0].Titre)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Evenement[0].Description)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Evenement[0].Categorie)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Evenement[0].DateDebut)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Evenement[0].DateFin)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Evenement[0].Annule)
                </th> 
                <th>
                     @Html.DisplayNameFor(model => model.Evenement[0].Addresse)
                </th>
                <th>
                     @Html.DisplayNameFor(model => model.Evenement[0].Ville)
                </th>
                <th>
                     @Html.DisplayNameFor(model => model.Evenement[0].CodePostal)
                </th> 
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model.Evenement) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Titre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Categorie.Nom)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateDebut)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DateFin)
                </td>
                @if (item.Annule == true)
                    {
                       <td>
                            Oui
                        </td> 
                    }
                    else
                    {   
                        <td>
                            Non
                        </td>
                    }
                <td>
                    @Html.DisplayFor(modelItem => item.Addresse)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Ville)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CodePostal)
                </td>  
                <td>
                    @if(User.Identity?.Name == item.Auteur.UserName)
                    {
                            if (item.Annule == false)
                            {   
                                <a class="btn btn-primary mb-3 d-block" asp-page="./Edit" asp-route-id="@item.Id">Modifier</a>
                                <a class="btn btn-primary mb-3 d-block" asp-page="./Delete" asp-route-id="@item.Id">Annuler</a>
                            }
                    }                
                    <a class="btn btn-primary mb-3 d-block" asp-page="./Details" asp-route-id="@item.Id">Détails</a>
                
                </td>
            </tr>
    }
        </tbody>
    </table>
}
