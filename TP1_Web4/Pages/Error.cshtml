@page "{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = $"Error {Model.StatusCode}";
}

<h1>
   Erreur @Model.StatusCode
</h1>

@if(Model.StatusCode == 404)
{
    <p>Page introuvable</p>
}
else if(Model.StatusCode == 403)
{
    <p>Acces interdit</p>
}
else
{
    <p>Une erreur du serveur est survenue.</p>
}