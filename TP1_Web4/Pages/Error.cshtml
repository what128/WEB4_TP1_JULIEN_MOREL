@page "{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = $"Erreur {Model.StatusCode}";
}

<h1>
   Erreur @Model.StatusCode
</h1>

@if(Model.StatusCode == 404)
{
    <p>Page introuvable</p>
}
else if(Model.StatusCode == 403)
{
    <p>Accès interdit</p>
}
else
{
    <p>Une erreur du serveur est survenue.</p>
}

<a href="/Index" class="btn btn-primary">Retourner à la page d'accueil</a>