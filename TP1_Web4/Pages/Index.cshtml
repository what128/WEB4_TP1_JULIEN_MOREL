@page
@model IndexModel
@{
    ViewData["Title"] = "Accueil";
}

@if (TempData["Confirmation"] != null)
{  
    <div class="alert alert-success alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Confirmation"]
   </div>
}

@if (TempData["Erreur"] != null)
{  
    <div class="alert alert-danger alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            @TempData["Erreur"]
   </div>
}

@if (TempData["Message"] != null)
{
	<div>
		<p>@TempData["Message"]</p>
	</div>
}

<h1 class="text-center my-4">Liste des évènements</h1>

<div class="card shadow-sm p-3 mb-4">
    <form asp-controller="Evenement" method="post">
        <div class="row align-items-end">
            <div class="col-md-4">
                <label for="categorieId" class="form-label">Catégorie</label>
                <select name="categorieId" id="categorieId" class="form-select" asp-for="CategorieId">
					@if (TempData["CategorieIdRecherche"] != null && (int)TempData["CategorieIdRecherche"] == -1)
					{
						<option value="-1" selected>Tous</option>
					}
					else
					{
						<option value="-1">Tous</option>
					}
                    @if (Model.Categories != null)
                    {
                        foreach (Categorie categorie in Model.Categories)
                        {
							@if (TempData["CategorieIdRecherche"] != null && (int)TempData["CategorieIdRecherche"] == categorie.Id)
							{
								<option value="@categorie.Id" selected>
									@categorie.Nom
								</option>
							}
							else
							{	
								<option value="@categorie.Id">
									@categorie.Nom
								</option>
							}
                        }
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label for="searchString" class="form-label">Recherche</label>
				@if (TempData["ContenuRecherche"] != null)
				{
					<input type="text" class="form-control" asp-for="Contenu" placeholder="Rechercher un évènement..." value="@TempData["ContenuRecherche"]"/>
				}
				else
				{	
					<input type="text" class="form-control" asp-for="Contenu" placeholder="Rechercher un évènement..." />
				}
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-primary">
                    Rechercher
                </button>
            </div>
        </div>
    </form>
</div>

@if (User.Identity.IsAuthenticated)
{
	<div class="text-center">
		<a asp-page="/Evenements/Create" class="btn btn-primary mb-3">Créer un évènement</a>
	</div>
}

@if(Model.Evenements.Count == 0)
{
	<div>
		<p class="text-center text-muted">Aucun évènement disponible en ce moment.</p>
	</div>
}
else
{
	<div class="container">
		<div class="row">
			@foreach(Evenement unEvenement in Model.Evenements)
			{
				<div class="col-md-6">
					<div class="card m-4 shadow-sm">
						<div class="card-body text-center">
							<img src="@Model.ImageFolder@unEvenement.Image" alt="Image de - @unEvenement.Titre" class="event-img"/>
							<h2>@unEvenement.Titre</h2>
							<p class="card-text">Date de début: @unEvenement.DateDebut</p>
							<p class="card-text">Date de fin: @unEvenement.DateFin</p>
							<p class="card-text">Ville: @unEvenement.Ville</p>
							@if (User.Identity.IsAuthenticated)
							{
								<p class="card-text">Addresse: @unEvenement.Addresse</p>
								
								@if (Model.Distances[unEvenement.Id] == -1)
								{
									<p class="card-text">Impossible de calculer la distance entre vous et l'évènement pour le moment.</p>
								}
								else
								{	
									<p class="card-text">Distance: @Model.Distances[unEvenement.Id].ToString() km</p>
								}
							}
							<a asp-page="/Evenements/Details" asp-route-id="@unEvenement.Id" class="btn btn-info mt-2">Voir les détails</a>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}

