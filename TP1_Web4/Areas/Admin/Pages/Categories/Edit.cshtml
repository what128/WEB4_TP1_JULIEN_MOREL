@page
@model TP1_Web4.Areas.Admin.Pages.Shared.Categories.EditModel

@{
    ViewData["Title"] = "Modifier une catégorie";
}

<h1>Modifier une catégorie</h1>

<h4>Categorie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Categorie.Id" />
            <div class="form-group">
                <label asp-for="Categorie.Nom" class="control-label"></label>
                <input asp-for="Categorie.Nom" class="form-control" />
                <span asp-validation-for="Categorie.Nom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Sauvegarder" class="btn btn-primary mt-3" />
            </div>
        </form>
    </div>
</div>

<div>
    <a class="btn btn-primary mt-3" asp-page="./Index">Retour à la liste</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
