@page
@model TP1_Web4.Areas.Admin.Pages.Shared.Categories.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Archiver une catégorie</h1>

<h3>Êtes-vous sûr de vouloir supprimer cette catégorie?</h3>
<div>
    <h4>Categorie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Categorie.Nom)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Categorie.Nom)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Categorie.Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" /> |
        <a asp-page="./Index">Retour à la liste</a>
    </form>
</div>
